# Database configuration
# PostgreSQL connection string for Neon or local database
DATABASE_URL="postgresql://user:password@host:port/database?schema=sigma_la&sslmode=require"

# JWT Configuration
# Secret key for JWT token generation (min 32 characters)
JWT_SECRET="your-secret-jwt-key-min-32-chars"

# Refresh Token Secret
# Secret key for refresh token generation
NODE_AUTH_REFRESH_TOKEN="your-refresh-token-secret"

# Server Configuration
PORT=4000

# Frontend URL for CORS configuration
FRONTEND_URL="http://localhost:5173"

# Environment
NODE_ENV="development"

# Optional: GitHub Auth Token (if needed)
NODE_AUTH_TOKEN=""

# Storage Configuration
STORAGE_PROVIDER="cloudinary"

# Cloudinary Configuration (required if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Email Configuration (Nodemailer for Dev)
# Examples below use Gmail. For Outlook/Hotmail use smtp.office365.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
# El correo desde el cual saldrán todos los mensajes
SMTP_USER="tu_correo_de_prueba@gmail.com"
# La contraseña de "Aplicación" (si usas Gmail, no es la contraseña normal)
SMTP_PASS="tu_contraseña_de_aplicacion"
# El "remitente" que leerán los usuarios que reciban el mail
MAIL_FROM='"Notificaciones Sistema" <tu_correo_de_prueba@gmail.com>'

# Sentry Configuration
# URL del DSN obtenida de Sentry.io para el proyecto backend
SENTRY_DSN=""
