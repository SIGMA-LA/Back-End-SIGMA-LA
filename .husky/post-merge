#!/usr/bin/env sh

echo "🔄 Running post-merge tasks..."

# Check if package.json was updated
if git diff HEAD~1 HEAD --name-only | grep -q "package.json"; then
    echo "📦 Dependencies updated, running pnpm install..."
    pnpm install
    echo "✅ Dependencies updated successfully!"
fi

# Check if package-lock or pnpm-lock was updated
if git diff HEAD~1 HEAD --name-only | grep -q "pnpm-lock.yaml"; then
    echo "🔒 Lock file updated, ensuring dependencies sync..."
    pnpm install
    echo "✅ Dependencies synced successfully!"
fi

# Check if Prisma schema was updated
if git diff HEAD~1 HEAD --name-only | grep -q "prisma/schema.prisma"; then
    echo "🗄️ Prisma schema updated, generating client..."
    pnpm prisma generate
    echo "⚠️ Remember to run migrations if needed: pnpm db:migrate"
    echo "✅ Prisma client regenerated successfully!"
fi

# Check if migrations were added
if git diff HEAD~1 HEAD --name-only | grep -q "prisma/migrations"; then
    echo "🚀 New migrations detected!"
    echo "⚠️ Run 'pnpm db:migrate' to apply them to your database"
fi

# Check if many source files changed (rebuild might be needed)
CHANGED_TS_FILES=$(git diff HEAD~1 HEAD --name-only | grep -E '\.(ts|js)$' | wc -l)
if [ "$CHANGED_TS_FILES" -gt 5 ]; then
    echo "🔧 Many TypeScript files changed ($CHANGED_TS_FILES), rebuilding..."
    pnpm build
    echo "✅ Build completed successfully!"
fi

# Check if .env.example was updated
if git diff HEAD~1 HEAD --name-only | grep -q ".env.example"; then
    echo "🔧 .env.example updated!"
    echo "⚠️ Check if you need to update your .env file with new variables"
fi

echo "✨ Post-merge tasks completed!"